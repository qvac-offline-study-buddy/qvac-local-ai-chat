import http from "http";
import {
  loadModel,
  LLAMA_3_2_1B_INST_Q4_0,
  completion
} from "@qvac/sdk";

import { buildStudyPrompt } from "./app.js";

const PORT = Number(process.env.PORT || 3000);

const modelId = await loadModel({
  modelSrc: LLAMA_3_2_1B_INST_Q4_0,
  onProgress: (progress) => {
    if (typeof progress?.percentage === "number") {
      console.log(`QVAC model loading: ${progress.percentage.toFixed(0)}%`);
    }
  }
});

console.log("QVAC Study Buddy model ready.");

const html = `<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QVAC Study Buddy</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 28px 18px;
      background: #f4f6fa;
      color: #111827;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    main { max-width: 720px; margin: 0 auto; }
    h1 { margin: 45px 0 8px; font-size: 40px; text-align: center; }
    .subtitle { text-align: center; font-size: 18px; margin-bottom: 28px; color: #4b5563; }
    label { display: block; font-weight: 700; margin: 14px 0 8px; }
    textarea {
      width: 100%; min-height: 90px; padding: 16px; border: 1px solid #d1d5db;
      border-radius: 16px; background: white; font-size: 18px; resize: vertical;
    }
    button {
      width: 100%; margin-top: 18px; padding: 17px; border: 0; border-radius: 16px;
      background: #111827; color: white; font-size: 17px; font-weight: 800;
    }
    button:disabled { opacity: .55; }
    .card {
      margin-top: 24px; padding: 24px; border-radius: 20px; background: white;
      box-shadow: 0 4px 18px rgba(0,0,0,.06);
    }
    .answer { white-space: pre-wrap; line-height: 1.55; font-size: 18px; }
    .small { color: #6b7280; font-size: 14px; margin-top: 14px; }
  </style>
</head>
<body>
  <main>
    <h1>QVAC Study Buddy</h1>
    <div class="subtitle">Ask a question and get an answer on your phone</div>

    <label for="question">Question</label>
    <textarea id="question" placeholder="e.g. Explain photosynthesis in simple terms"></textarea>

    <label for="materials">Study materials (optional)</label>
    <textarea id="materials" placeholder="Paste notes, a topic, or study material here"></textarea>

    <button id="ask" onclick="askStudyBuddy()">ASK STUDY BUDDY</button>

    <section class="card">
      <h2>Answer</h2>
      <div id="answer" class="answer">Your answer will appear here.</div>
      <div class="small">Powered by QVAC local inference.</div>
    </section>
  </main>

  <script>
    async function askStudyBuddy() {
      const question = document.getElementById("question").value.trim();
      const materials = document.getElementById("materials").value.trim();
      const answer = document.getElementById("answer");
      const button = document.getElementById("ask");

      if (!question) {
        answer.textContent = "Please enter a study question.";
        return;
      }

      button.disabled = true;
      answer.textContent = "Thinking locally with QVAC...";

      try {
        const response = await fetch("/api/study", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ question, materials })
        });

        const data = await response.json();

        if (!response.ok) throw new Error(data.error || "Request failed.");
        answer.textContent = data.answer;
      } catch (error) {
        answer.textContent = "Error: " + error.message;
      } finally {
        button.disabled = false;
      }
    }
  </script>
</body>
</html>`;

const server = http.createServer(async (req, res) => {
  if (req.method === "GET" && req.url === "/") {
    res.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
    res.end(html);
    return;
  }

  if (req.method === "POST" && req.url === "/api/study") {
    let body = "";

    req.on("data", chunk => {
      body += chunk;
      if (body.length > 1_000_000) req.destroy();
    });

    req.on("end", async () => {
      try {
        const { question, materials = "" } = JSON.parse(body || "{}");

        if (!question?.trim()) {
          res.writeHead(400, { "Content-Type": "application/json" });
          res.end(JSON.stringify({ error: "A study question is required." }));
          return;
        }

        const prompt = buildStudyPrompt(question, materials);
        const result = completion({
          modelId,
          history: [{ role: "user", content: prompt }],
          stream: true
        });

        let answer = "";
        for await (const token of result.tokenStream) {
          answer += token;
        }

        res.writeHead(200, { "Content-Type": "application/json" });
        res.end(JSON.stringify({ answer: answer.trim() }));
      } catch (error) {
        console.error("Study Buddy error:", error);
        res.writeHead(500, { "Content-Type": "application/json" });
        res.end(JSON.stringify({ error: error.message }));
      }
    });

    return;
  }

  res.writeHead(404, { "Content-Type": "text/plain" });
  res.end("Not found");
});

server.listen(PORT, "0.0.0.0", () => {
  console.log(`QVAC Study Buddy running on port ${PORT}`);
